# Copy to .env (already git-ignored) and fill in. Never commit the real .env.
# Leave MAIL_SERVER empty to only log emails to the console (dry run).
MAIL_SERVER=
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Футболна Академия Герман
MAIL_REPLY_TO=

# Folder for photos uploaded from the admin. Empty = backend/uploads
UPLOAD_DIR=

# Public site address, used in Facebook share tags. Leave empty locally.
SITE_URL=

# Магазин: на кой имейл да пристига всяка нова поръчка (главният треньор).
# Ако е празно, ползва се MAIL_REPLY_TO, после MAIL_FROM.
SHOP_ORDER_EMAIL=

# Documents for the BFS registration (ID cards, birth certificates, medical): encrypted files,
# stored OUTSIDE the public folders. Empty DOCS_DIR = backend/documents.
# DOCS_KEY: generate once with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it in the backups together with the folder: without the key the files cannot be read.
DOCS_DIR=
DOCS_KEY=
