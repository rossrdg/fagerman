@@ -272,3 +272,12 @@ flask --app run import-products items-list.xlsx --images папка_със_сн
 Без настроен `MAIL_SERVER` (тестов режим) имейлите се записват в лога на сървъра и НЕ се броят за изпратени.
 Изпращането е последователно, в самата заявка (до 300 получатели) — на сървъра ще се замени с изпращане на опашка
 през няколко секунди. Колоните `emailed_at`/`emailed_count` се добавят автоматично към съществуваща таблица.
+
+## Защити и пускане в production
+
+- **Debug:** `backend/run.py` стартира Flask в debug режим само ако е зададено `FLASK_DEBUG=1` (локално, в `.env`) и никога
+  при `SESSION_COOKIE_SECURE=1`. На сървъра приложението се пуска през WSGI, не през `run.py`.
+- **Едновременни заявки:** редовете за документи и такси се създават „при отваряне“ на страница. Ако две заявки го направят
+  едновременно, втората среща уникално ограничение (`IntegrityError`): сесията се връща и заявката се изпълнява още веднъж
+  (вторият път редовете вече съществуват); втори неуспех е истински конфликт и връща 409. Проверка: `tests/test_hardening.py`.
+- **Не се комитват:** `.env`, базите, `documents/`, `uploads/`, `.idea/` (виж `.gitignore`).
diff --git a/backend/app/__init__.py b/backend/app/__init__.py
index 9d88350..dc45fd4 100644
--- a/backend/app/__init__.py
+++ b/backend/app/__init__.py
@@ -3,6 +3,7 @@ import os
 from flask import Flask, redirect, send_from_directory
 from flask_sqlalchemy import SQLAlchemy
 from flask_cors import CORS
+from sqlalchemy.exc import IntegrityError
 
 db = SQLAlchemy()
 
@@ -119,6 +120,21 @@ def create_app(config_object="config.Config"):
     app.register_blueprint(uploads_bp, url_prefix="/api")  # POST /api/admin/uploads
     app.register_blueprint(files_bp)  # GET /uploads/<file>
 
+    @app.errorhandler(IntegrityError)
+    def retry_after_race(_err):
+        """Редовете за документи и такси се създават „при отваряне“ на страница. Ако две заявки го направят
+        едновременно, втората среща уникално ограничение. Връщаме сесията и изпълняваме заявката още веднъж —
+        вторият път редовете вече съществуват. Втори неуспех е истински конфликт (409), не безкраен цикъл."""
+        from flask import g, jsonify
+
+        db.session.rollback()
+        if g.get("_race_retried"):
+            return jsonify({"ok": False, "error": "Конфликт при запис. Опитайте отново."}), 409
+        g._race_retried = True
+        for cached in ("_admin_user", "_parent"):
+            g.pop(cached, None)  # свързани са със сесията, която току-що върнахме
+        return app.full_dispatch_request()
+
     @app.errorhandler(413)
     def too_large(_err):
         from flask import jsonify
